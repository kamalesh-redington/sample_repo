{
    "tenant_id": "string",
    "source_type": "unstructured | structured",
    "source": {
        "file": {
            "file_name": "string",
            "file_type": "pdf | docx | txt | csv | json",
            "file_url": "string",
            "file_size": 123456
        },
        "database": {
            "db_type": "postgres | mysql | mssql | oracle",
            "host": "string",
            "port": 5432,
            "database_name": "string",
            "schema": "public",
            "username": "string",
            "password": "encrypted",
            "tables": [
                "table1",
                "table2"
            ],
            "query": "optional custom SQL"
        }
    },
    "processing": {
        "chunking": {
            "strategy": "fixed | semantic | recursive",
            "chunk_size": 512,
            "chunk_overlap": 50
        },
        "cleaning": {
            "remove_html": true,
            "remove_special_chars": true,
            "normalize_whitespace": true
        },
        "metadata_extraction": {
            "enabled": true,
            "fields": [
                "title",
                "author",
                "date"
            ]
        }
    },
    "embedding": {
        "model": "text-embedding-3-small",
        "provider": "openai | local | huggingface",
        "batch_size": 100,
        "dimension": 1536
    },
    "vector_store": {
        "type": "pgvector | pinecone | weaviate",
        "index_name": "tenant_index_01",
        "namespace": "optional",
        "recreate_index": false
    },
    "access_control": {
        "roles": [
            "admin",
            "analyst",
            "viewer"
        ],
        "users": [
            "user_id_1",
            "user_id_2"
        ],
        "groups": [
            "finance_team"
        ],
        "visibility": "private | tenant | public"
    },
    "tags": [
        "finance",
        "invoice",
        "2026"
    ],
    "versioning": {
        "enabled": true,
        "version_label": "v1.0"
    },
    "job_control": {
        "async": true,
        "priority": "low | medium | high",
        "notify_on_completion": true
    }
}